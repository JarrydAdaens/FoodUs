<?xml version="1.0" encoding="utf-8"?>
<!-- FoodUs launcher icon: owner-made bitmap art inset to the safe zone over a
     background sampled from the art's own edge color, so launcher masks extend
     the art seamlessly. No monochrome layer - the art is full-color and the old
     brand glyph would be wrong; themed-icon launchers fall back to this icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
